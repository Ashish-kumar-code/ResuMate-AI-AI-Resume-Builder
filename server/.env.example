# ============================================================================
# ResuMate AI - Server Environment Variables Template
# ============================================================================
# Copy this file to .env and fill in the required values
# Never commit .env to version control
# ============================================================================

# DATABASE CONFIGURATION
# MongoDB Atlas connection string (TLS/SSL enabled)
# Get connection string: https://cloud.mongodb.com/v2 → Your Project → Connect
MONGODB_URI=mongodb+srv://username:password@cluster-url

# AUTHENTICATION
# Generate a strong JWT secret:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your_jwt_secret_here

# API GATEWAY
# Frontend URL for CORS (update for production deployment)
CLIENT_URL=http://localhost:5173

# OPENAI CONFIGURATION
# Get API key from: https://platform.openai.com/api-keys
# Set project spending limits and key permissions in OpenAI dashboard
OPENAI_API_KEY=sk-...

# IMAGEKIT CONFIGURATION
# Sign up: https://imagekit.io
# Get Private Key: Dashboard → Developer → API Keys
IMAGEKIT_PRIVATE_KEY=private_...

# SERVER CONFIGURATION
PORT=3000

# ENVIRONMENT
NODE_ENV=development
